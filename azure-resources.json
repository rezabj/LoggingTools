{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": { "type": "string" },
    "ruleName": { "type": "string", "defaultValue": "LoggingTools-dcr" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "createWorkspace": { "type": "bool", "defaultValue": true }
  },
  "variables": {
    "columns": [
      { "name": "TimeGenerated", "type": "datetime" },
      { "name": "EventId", "type": "string" },
      { "name": "Level", "type": "string" },
      { "name": "Message", "type": "string" },
      { "name": "Application", "type": "string" },
      { "name": "HostName", "type": "string" },
      { "name": "ProcessId", "type": "int" },
      { "name": "CorrelationId", "type": "string" },
      { "name": "Data", "type": "dynamic" },
      { "name": "Exception", "type": "dynamic" }
    ]
  },
  "resources": [
    {
      "condition": "[parameters('createWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": { "sku": { "name": "PerGB2018" }, "retentionInDays": 30 }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('workspaceName'), '/LoggingTools_CL')]",
      "dependsOn": ["[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"],
      "properties": { "schema": { "name": "LoggingTools_CL", "columns": "[variables('columns')]" } }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2024-03-11",
      "name": "[parameters('ruleName')]",
      "location": "[parameters('location')]",
      "kind": "Direct",
      "dependsOn": ["[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'LoggingTools_CL')]"],
      "properties": {
        "streamDeclarations": { "Custom-LoggingTools": { "columns": "[variables('columns')]" } },
        "destinations": { "logAnalytics": [{ "name": "workspace", "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]" }] },
        "dataFlows": [{ "streams": ["Custom-LoggingTools"], "destinations": ["workspace"], "transformKql": "source", "outputStream": "Custom-LoggingTools_CL" }]
      }
    }
  ],
  "outputs": {
    "workspaceResourceId": { "type": "string", "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]" },
    "ruleResourceId": { "type": "string", "value": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('ruleName'))]" },
    "ruleImmutableId": { "type": "string", "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('ruleName')), '2024-03-11').immutableId]" },
    "ingestionEndpoint": { "type": "string", "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('ruleName')), '2024-03-11').endpoints.logsIngestion]" }
  }
}
